@startuml context-smart-home
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()
SHOW_PERSON_SPRITE()

title C4 Диаграмма контекста: Умный дом\nPropDevelopment

' ── Персоны ──────────────────────────────────────────────────────────────────
Person(owner, "Собственник", "Владелец квартиры.\nУправляет списком доступа (биометрия,\nномера авто), просматривает журнал\nсобытий через мобильное приложение.")

Person(visitor, "Жилец / Посетитель", "Жильцы и гости здания.\nФизически взаимодействуют с домофоном:\nзвонок или автоматическая идентификация\nпо биометрии лица.")

Person(driver, "Автовладелец\n(собственник)", "Въезжает на парковку.\nГос. номер автомобиля распознаётся\nшлагбаумом автоматически.")

' ── Система PropDevelopment (в фокусе) ───────────────────────────────────────
System(prop, "PropDevelopment", "Мобильное приложение собственника\n(Витрина ЖКУ) + backend-сервисы:\ntenant-core-app, smart-home-gateway.\nУправляет списком доступа.\nБиометрические шаблоны НЕ хранит.")

' ── Внешние системы ──────────────────────────────────────────────────────────
System_Ext(partner, "Платформа умного дома\nпартнёра", "SaaS-платформа партнёра.\nУправляет IoT-устройствами.\nХранит биометрические шаблоны\nи whitelist номеров авто.\nСерверы физически в РФ.")

System_Ext(intercom, "Интеллектуальный\nдомофон", "IoT-устройство.\nВидеодомофон с модулем распознавания лиц.\nОткрывает дверь по команде или\nавтоматически по биометрии.\nРаботает автономно до 72 ч.")

System_Ext(barrier, "Интеллектуальный\nшлагбаум", "IoT-устройство.\nШлагбаум с камерой распознавания\nгос. номеров автомобилей.\nОткрывает въезд автоматически\nпо whitelist номеров.")

' ── Связи ────────────────────────────────────────────────────────────────────
Rel(owner, prop, "Управляет доступом,\nпросматривает журнал событий", "Mobile App / HTTPS / OAuth 2.0")

Rel(prop, partner, "Управление доступом:\nwhitelist авто (plate_hash),\nразрешения биометрии (user_id),\nполучение событий (webhooks)", "REST API / HTTPS + mTLS")

Rel(partner, intercom, "Конфигурация доступа,\nбиометрические шаблоны,\nкоманды управления", "Зашифрованный канал")

Rel(partner, barrier, "Список разрешённых\nномеров авто,\nкоманды управления", "Зашифрованный канал")

Rel(visitor, intercom, "Звонит в домофон или\nидентифицируется по лицу", "Физически")

Rel(driver, barrier, "Въезжает на парковку,\nкамера считывает гос. номер", "Физически")

SHOW_LEGEND()
@enduml
